<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only test hooks for the Home Screen widgets (merged into debug builds only). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Driven from adb: `am broadcast` to this receiver with action
             com.bringyour.network.debug.PIN_WIDGET (string extra kind = dashboard, globe or
             contracts) pins a widget; action com.bringyour.network.debug.SAMPLE (boolean extra
             enabled) switches the widgets to the sample entry. See DebugWidgetReceiver. -->
        <receiver
            android:name=".widgets.DebugWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.bringyour.network.debug.PIN_WIDGET" />
                <action android:name="com.bringyour.network.debug.SAMPLE" />
            </intent-filter>
        </receiver>
        <!-- Physical peer-to-peer rig hooks (connect/tools/flightgate-devices): sign in,
             provide settings, connect to a network peer, disconnect, status. See
             FlightGateDebugReceiver. -->
        <receiver
            android:name=".FlightGateDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.bringyour.network.debug.FG_LOGIN" />
                <action android:name="com.bringyour.network.debug.FG_PROVIDE" />
                <action android:name="com.bringyour.network.debug.FG_CONNECT_PEER" />
                <action android:name="com.bringyour.network.debug.FG_DISCONNECT" />
                <action android:name="com.bringyour.network.debug.FG_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
