<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AGP injects runner settings into the FIRST instrumentation element.
         Keep that slot on the default runner; the opt-in component is second. -->
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="com.bringyour.network" />
    <instrumentation
        android:name="com.bringyour.network.acceptance.PhysicalCredentialDiagnosticRunner"
        android:targetPackage="com.bringyour.network"
        android:functionalTest="false"
        android:handleProfiling="false" />

    <application>
        <!--
          The product excludes its own UID from the VPN.  Run the acceptance
          egress request in the test APK's UID so it follows the same path as
          other apps on the device.
        -->
        <activity
            android:name="com.bringyour.network.acceptance.EgressProbeActivity"
            android:exported="true"
            android:process=":egress_probe"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
